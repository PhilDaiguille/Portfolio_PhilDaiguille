---
import Phone from '@lucide/astro/icons/phone';
import Mail from '@lucide/astro/icons/mail';
import FileText from '@lucide/astro/icons/file-text';
import { getContactInfo, getCopyrightYear } from '../../application/getSiteInfo';

interface Props {
  showCv?: boolean;
}

const { showCv = false } = Astro.props;
const { phone, phoneHref, email, emailHref, cvHref, socialLinks } = getContactInfo();
const year = getCopyrightYear();
---

<footer id="Contact">
  <h2 class="History">Contact</h2>
  <address class="contact">
    <ul>
      <li>
        <a href={phoneHref}><Phone size={24} aria-hidden="true" />{phone}</a>
      </li>
      <li>
        <a href={emailHref}><Mail size={24} aria-hidden="true" />{email}</a>
      </li>
      {showCv && (
        <li>
          <a href={cvHref} target="_blank" rel="noopener"><FileText size={24} aria-hidden="true" />CV (PDF)</a>
        </li>
      )}
    </ul>
    <!-- ponytail: Lucide n'a plus d'icônes de marque, on garde les SVG des réseaux. -->
    <ul class="socials">
      {socialLinks.map((social) => (
        <li>
          <a href={social.href} target="_blank" rel="noopener me" aria-label={`${social.label} (nouvel onglet)`}>
            <img src={social.icon} alt="" width="32" height="32" loading="lazy" />
          </a>
        </li>
      ))}
    </ul>
  </address>
  <p>Copyright &copy; {year} - Philippe DELENTE</p>
</footer>
