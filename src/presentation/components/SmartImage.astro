---
// <Image> optimisée pour les imports locaux ; les URLs distantes (logos SVG) restent en <img>.
import { Image } from 'astro:assets';
import type { ImageSource } from '../../domain/portfolio';

interface Props {
  src: ImageSource;
  alt: string;
  class?: string;
  /** Largeur max affichée : borne le srcset généré. */
  width?: number;
  /** Image distante uniquement : réserve la place avant chargement (carré par défaut). */
  height?: number;
  loading?: 'lazy' | 'eager';
}

const { src, alt, class: className, width = 800, height = width, loading = 'lazy' } = Astro.props;
---

{typeof src === 'string' ? (
  <img src={src} alt={alt} class={className} width={width} height={height} loading={loading} decoding="async" />
) : (
  <Image src={src} alt={alt} class={className} width={Math.min(width, src.width)} loading={loading} />
)}
