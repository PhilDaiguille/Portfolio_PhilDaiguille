---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../presentation/components/SiteHeader.astro';
import SmartImage from '../presentation/components/SmartImage.astro';
import ProjectCard from '../presentation/components/ProjectCard.astro';
import CardGrid from '../presentation/components/CardGrid.astro';
import { getHomeContent } from '../application/getHomeContent';
import GraduationCap from '@lucide/astro/icons/graduation-cap';
import MapPin from '@lucide/astro/icons/map-pin';
import Download from '@lucide/astro/icons/download';
import { getContactInfo } from '../application/getSiteInfo';
import { withBase } from '../application/url';
import profilePicture from '../assets/images/pp.webp';

const { experiences, skillGroups, otherSkills, education, featured, loisirs, veille, navLinks } = getHomeContent();
const { cvHref } = getContactInfo();

// ponytail: chiffres en dur, à mettre à jour à la main.
const keyFigures = [
  { value: '3 ans+', label: 'chez Les Echos Le Parisien Services, en alternance puis en CDD' },
  { value: 'Bac+5', label: 'Mastère Ingénierie du web, ESGI Paris' },
  { value: '130', label: 'contributions à la documentation officielle de PHP' },
  { value: '89', label: "règles d'accessibilité publiées en open source" },
];
---

<BaseLayout
  title="Philippe Delente — Développeur web full-stack PHP / Symfony & TypeScript"
  description="Portfolio de Philippe Delente, développeur web full-stack PHP / Symfony et TypeScript : outils open source d'accessibilité et de SEO, applications Next.js, NestJS et Vue."
  fullSeo
  showCv
>
  <SiteHeader slot="header" links={navLinks} isHome />

  <!-- Hero -->
  <section class="hero">
    <div>
      <h2 class="hero-title"><span>Développeur<span class="com">&</span></span> <span>Créatif</span></h2>
    </div>
    <div class="content">
      <p>Développeur web full-stack <strong>PHP / Symfony</strong> et <strong>TypeScript</strong>. Je conçois des applications accessibles, rapides et bien référencées, et je publie des outils open source pour y arriver.</p>
      <div class="hero-actions">
        <a href="#projets" class="btn-contact">Voir mes projets</a>
        <a href="#Contact" class="btn-ghost">Contactez-moi</a>
      </div>
      <p class="availability">
        <MapPin size={18} aria-hidden="true" /> Paris · CDD chez Les Echos Le Parisien Services · ouvert aux opportunités
        <a href={cvHref} download><Download size={18} aria-hidden="true" /> Mon CV (PDF)</a>
      </p>
    </div>
  </section>

  <!-- Information -->
  <section class="information">
    <div>
      <h2 id="info" class="History">Qui suis-je</h2>
      <div class="content">
        <p>
          Je m'appelle Philippe Delente, développeur web full-stack. Diplômé d'un Mastère Ingénierie du web à l'ESGI, je travaille chez Les Echos Le Parisien Services, d'abord en alternance depuis 2023, aujourd'hui en CDD : sites et applications en PHP / Symfony, WordPress, Vue.js et React.
        </p>
        <p>
          Ce qui me motive, c'est le web bien fait : accessible, rapide et bien référencé. J'ai publié un linter d'accessibilité pour Twig, je développe un crawler d'audit SEO en Rust et je contribue à la traduction de la documentation officielle de PHP.
        </p>
        <p>
          En dehors du code, je dessine et je photographie. Ce regard visuel nourrit mon travail sur les interfaces et l'expérience utilisateur.
        </p>
      </div>
    </div>
    <div>
      <Image src={profilePicture} alt="Portrait de Philippe Delente, développeur web" width={560} />
    </div>
  </section>

  <!-- Chiffres clés -->
  <section class="figures" aria-label="Chiffres clés">
    <ul class="cards">
      {keyFigures.map((f) => (
        <li class="card">
          <strong>{f.value}</strong>
          <span>{f.label}</span>
        </li>
      ))}
    </ul>
  </section>

  <!-- Projets -->
  <section class="travaux" id="travaux">
    <h2 id="projets" class="History"><a href={withBase('/projets/')}>Projets</a></h2>
    <ul class="cards projects bento">
      {featured.map((p) => <ProjectCard project={p} />)}
    </ul>
    <p class="see-all"><a class="btn-ghost" href={withBase('/projets/')}>Tous les projets →</a></p>
  </section>

  <!-- Experience -->
  <section class="experience">
    <h2 id="Experience" class="History">Expérience</h2>
    {experiences.map((exp) => (
      <figure>
        <a href={exp.link} class:list={['exp-logo', { invert: exp.logoInvert }]}><SmartImage src={exp.logo} alt={`Logo ${exp.organization}`} width={220} /></a>
        <ul>
          <li>
            <h2> <time datetime={exp.year.slice(0, 4)}>{exp.year}</time> • {exp.role} </h2>
          </li>
          <li>{exp.organization}</li>
          {exp.steps && (
            <li>
              <ol class="exp-steps">
                {exp.steps.map((step) => (
                  <li>
                    <time datetime={step.year.slice(0, 4)}>{step.year}</time>
                    <span>{step.role}</span>
                  </li>
                ))}
              </ol>
            </li>
          )}
          {exp.details && (
            <li>
              <ul class="resume">
                {exp.details.map((detail) => <li>{detail}</li>)}
              </ul>
            </li>
          )}
        </ul>
      </figure>
    ))}
  </section>

  <!-- Compétences -->
  <section class="compet">
    <h2 id="Compétences" class="History">Compétences</h2>
    <ul class="cards skill-groups">
      {skillGroups.map((group) => (
        <li class="card">
          <h3>{group.title}</h3>
          <ul class="skill-list">
            {group.skills.map((skill) => (
              <li class:list={{ 'skill-text': !skill.icon }}>
                {skill.icon && <img src={withBase(skill.icon)} alt="" width="32" height="32" loading="lazy" />}
                {skill.name}
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ul>
    <h3 class="skill-other-title">Aussi pratiqué</h3>
    <ul class="stack skill-other">
      {otherSkills.map((name) => <li>{name}</li>)}
    </ul>
  </section>

  <!-- Formation -->
  <section class="formation">
    <h2 id="Formation" class="History">Formation</h2>
    <figure>
      {education.map((item) => (
        <ul>
          <li><GraduationCap size={64} stroke-width={1.5} aria-hidden="true" /></li>
          <li>
            <h2>{item.title}</h2>
            <p>{item.school}</p>
          </li>
        </ul>
      ))}
    </figure>
  </section>

  <!-- Loisirs -->
  <section class="loisir">
    <h2 id="Loisirs" class="History"><a href={withBase('/loisirs/')}>Loisirs</a></h2>
    <CardGrid items={loisirs} />
  </section>

  <!-- Veille -->
  <section class="veille">
    <h2 id="Veille" class="History"><a href={withBase('/veille/')}>Veille Technologique</a></h2>
    <CardGrid items={veille} />
  </section>

</BaseLayout>
