---
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCarouselProjects } from '../../../application/getCarouselProjects';

const projects = getCarouselProjects();
---

<BaseLayout title="Travaux" description="Portfolio" canonical="https://phildaiguille.fr/projet/personnel/" stylesheet="/css/Travaux.css" showScrollTop={false}>
  <Fragment slot="head">
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css"
      integrity="sha512-1ycn6IcaQQ40/MKBW2W4Rhis/DbILU74C1vSrLJxCq57o941Ym01SwNsOMqvEBFlcgUa6xLiPY/NS5R+E6ztJQ=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.css" />
    <script is:inline src="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.js"></script>
  </Fragment>

  <header slot="header">
    <h1>
      <a href="/#travaux">Projet</a>
    </h1>
  </header>

  <div class="swiper">
    <div class="swiper-wrapper">
      {projects.map((project) => (
        <section class="swiper-slide">
          <h2>{project.title}</h2>
          <Image src={project.image} alt="" />
          <p><a href={project.href}>Voir Projet</a></p>
        </section>
      ))}
    </div>

    <div class="pagination"></div>

    <div class="prev">
      <svg width="10" height="15" viewBox="0 0 10 15" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M9.2625 13.2375L3.5375 7.5L9.2625 1.7625L7.5 0L0 7.5L7.5 15L9.2625 13.2375Z" fill="#A99260"></path>
      </svg>
    </div>
    <div class="next">
      <svg width="10" height="15" viewBox="0 0 10 15" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M0.737305 13.2375L6.4623 7.5L0.737305 1.7625L2.4998 0L9.9998 7.5L2.4998 15L0.737305 13.2375Z" fill="#A99260"></path>
      </svg>
    </div>
  </div>

  <Fragment slot="scripts">
    <script is:inline>
      new Swiper('.swiper', {
        slidesPerView: 2,
        spaceBetween: 50,
        loop: true,
        grabCursor: true,
        centeredSlides: true,
        slideActiveClass: 'active',
        navigation: { nextEl: '.next', prevEl: '.prev' },
        pagination: { el: '.pagination', clickable: true },
      });
    </script>
  </Fragment>
</BaseLayout>
