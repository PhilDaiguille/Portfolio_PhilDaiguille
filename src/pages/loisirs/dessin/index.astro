---
import { Picture } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import dessin1 from '../../../assets/images/assetdessin/dessin1.webp';
import dessin2 from '../../../assets/images/assetdessin/dessin2.webp';
import dessin3 from '../../../assets/images/assetdessin/dessin3.webp';

const drawings = [
  { src: dessin1, title: "L'ornicool" },
  { src: dessin2, title: 'Femme' },
  { src: dessin3, title: 'Cosmos' },
];
---

<BaseLayout
  title="Dessin et art numérique — Philippe Delente"
  description="Galerie de dessins et d'illustrations de Philippe Delente, entre art traditionnel et création numérique : L'ornicool, Femme, Cosmos."
  heading="Dessin"
  lead="Arts plastiques et arts numériques : une sélection de mes illustrations."
  accent="loisir"
  schema={{ '@type': 'ImageGallery', name: 'Dessins de Philippe Delente', creator: { '@type': 'Person', name: 'Philippe Delente' } }}
>
  <ul class="gallery">
    {drawings.map((drawing) => (
      <li>
        <figure>
          <Picture src={drawing.src} formats={['avif', 'webp']} width={900} alt={`Dessin « ${drawing.title} » par Philippe Delente`} loading="lazy" />
          <figcaption>{drawing.title}</figcaption>
        </figure>
      </li>
    ))}
  </ul>
</BaseLayout>
